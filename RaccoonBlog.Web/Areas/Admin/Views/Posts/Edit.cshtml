@using RaccoonBlog.Web.Models
@model PostInput
<!-- TinyMCE -->
@section Script {

	<script type="text/javascript">
		$(function () {
			$('.datepicker input').datetimepicker();
		});
	</script>
	<script type="text/javascript">
		tinymce.init({
			selector: "textarea",
			theme: "modern",
			plugins: [
                "advlist autolink lists link image charmap print preview hr anchor pagebreak",
                "searchreplace wordcount visualblocks visualchars code fullscreen",
                "insertdatetime media nonbreaking save table contextmenu directionality",
                "emoticons template paste textcolor colorpicker textpattern"
			],
			toolbar1: "insertfile undo redo | styleselect | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image",
			toolbar2: "print preview media | forecolor backcolor emoticons",
			image_advtab: true,
            file_picker_types: 'image',
            file_picker_callback: function (callback, value, meta) {
                if (meta.filetype === 'image') {
                    var input = document.createElement('input');
                    input.setAttribute('type', 'file');
                    input.setAttribute('accept', 'image/*');
	                
                    input.onchange = function () {
                        var file = this.files[0];
                        var formData = new FormData();
                        formData.append('file', file);
	                    
	                    fetch('@Url.Action("UploadImage", "Posts", new { area = "Admin" })', {
		                    method: 'POST',
		                    body: formData,
		                    credentials: 'same-origin'
	                    })
		                    .then(function(response) {
			                    if (!response.ok) {
				                    return response.text().then(function(text) {
					                    throw new Error(text);
				                    });
			                    }
			                    return response.json();
		                    })
		                    .then(function(result) {
			                    if (result.location) {
				                    callback(result.location, { alt: file.name });
			                    } else {
									alert('Error: The server did not return the image URL.');
			                    }
		                    })
		                    .catch(function(error) {
								console.error('Server error:', error.message);
								alert('C# error:\n' + error.message);
		                    }); 
                    };
                    input.click();
                }
            },
            paste_data_images: true,
			templates: [
                { title: 'Test template 1', content: 'Test 1' },
                { title: 'Test template 2', content: 'Test 2' }
			],
			convert_urls: false,
			relative_urls: false
		});
	</script>
}
@{
	ViewBag.Title = @Model.Title;
}
@if (ViewData.ModelState.IsValid == false)
{
	<div class="form-error">
		@Html.ValidationSummary(true)
	</div>
}
<h3 class="pull-left-sm">@(Model.IsNewPost() ? "Add new post" : "Edit Post")</h3>
<a href='@Url.Action("Index", "Posts")' class="btn btn-primary btn-sm pull-right-sm">View posts</a>
<div class="clearfix"></div>
<hr />

@using (Html.BeginForm("Update", "Posts", Microsoft.AspNetCore.Mvc.Rendering.FormMethod.Post, new { @class = "form-horizontal" }))
{
	<div class="row">
		<div class="col-lg-4">
			@Html.HiddenFor(x => x.Id)
			@Html.EditorFor(x => x.Title, "TextAbove")
			@Html.EditorFor(x => x.CreatedAt, "DateTime")
			@Html.EditorFor(x => x.PublishAt, "DateTime")
			@Html.EditorFor(x => x.Tags, "TextAbove")
			@Html.EditorFor(x => x.AllowComments)
		</div>
		<div class="col-lg-8">
			@Html.TextAreaFor(x => x.Body, new { rows = "20" })
		</div>

	</div>
	@if (!string.IsNullOrEmpty(Model.SeoMetaDescription) || !string.IsNullOrEmpty(Model.SeoKeywords))
	{
		<hr />
		<div class="row">
			<div class="col-lg-12">
				<h4>SEO (auto-generated)</h4>
				<div class="form-group">
					<label>Meta Description</label>
					<p class="form-control-static" style="background-color: #f5f5f5; padding: 10px;">@(Model.SeoMetaDescription ?? "Not yet analyzed")</p>
				</div>
				<div class="form-group">
					<label>Keywords</label>
					<p class="form-control-static" style="background-color: #f5f5f5; padding: 10px;">@(Model.SeoKeywords ?? "Not yet analyzed")</p>
				</div>
				@if (Model.SeoLastAnalyzedAt.HasValue)
				{
					<p><small>Last analyzed: @Model.SeoLastAnalyzedAt.Value.ToString("r")</small></p>
				}
			</div>
		</div>
	}
	<input type="submit" value="Save" class="btn btn-primary pull-right" style="margin-top:20px" />
	<div class="clearfix"></div>
}