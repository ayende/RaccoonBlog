<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude files not needed -->
    <Compile Remove="ViewModels\BlogConfigurationInput.cs" />
    
    <!-- Exclude old MetaWeblog/XmlRpc files - replaced by MetaWeblogService using WilderMinds.MetaWeblog -->
    <Compile Remove="Services\MetaWeblog.cs" />
    <Compile Remove="Services\IMetaWeblog.cs" />
    <Compile Remove="Services\RssModels\BlogInfo.cs" />
    <Compile Remove="Services\RssModels\Category.cs" />
    <Compile Remove="Services\RssModels\CategoryInfo.cs" />
    <Compile Remove="Services\RssModels\Enclosure.cs" />
    <Compile Remove="Services\RssModels\MediaObject.cs" />
    <Compile Remove="Services\RssModels\MediaObjectInfo.cs" />
    <Compile Remove="Services\RssModels\Post.cs" />
    <Compile Remove="Services\RssModels\Source.cs" />
    <Compile Remove="Services\RssModels\UserInfo.cs" />
    <Compile Remove="Services\RssModels\WordpressCategory.cs" />

    <!-- Exclude unused helpers that depend on old System.Web.Mvc types -->
    <Compile Remove="Helpers\StaticFileUrlHelperExtensions.cs" />
    <Content Remove="compilerconfig.json" />
    <None Include="compilerconfig.json" />
    <None Include="Services\MetaWeblog.cs" />
    <None Include="Services\IMetaWeblog.cs" />
    <None Include="Services\RssModels\BlogInfo.cs" />
    <None Include="Services\RssModels\Category.cs" />
    <None Include="Services\RssModels\CategoryInfo.cs" />
    <None Include="Services\RssModels\Enclosure.cs" />
    <None Include="Services\RssModels\MediaObject.cs" />
    <None Include="Services\RssModels\MediaObjectInfo.cs" />
    <None Include="Services\RssModels\Post.cs" />
    <None Include="Services\RssModels\Source.cs" />
    <None Include="Services\RssModels\UserInfo.cs" />
    <None Include="Services\RssModels\WordpressCategory.cs" />
    <None Include="Helpers\StaticFileUrlHelperExtensions.cs" />
    <None Include="wwwroot\images\android-chrome-192x192.png" />
    <None Include="wwwroot\images\android-chrome-512x512.png" />
    <None Include="wwwroot\images\apple-touch-icon.png" />
    <None Include="wwwroot\images\favicon-16x16.png" />
    <None Include="wwwroot\images\favicon-32x32.png" />
    <None Include="wwwroot\images\favicon.ico" />
    <None Include="wwwroot\site.webmanifest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core ASP.NET Core packages -->
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" Version="8.0.0" />
    
    <!-- AutoMapper - Upgraded to 15.1.1 to fix GHSA-rvv3-g6hj-g44x (DoS via uncontrolled recursion) -->
    <!-- DI extensions are included in the core package since 13.0 -->
    <PackageReference Include="AutoMapper" Version="15.1.1" />
    
    <!-- Keep compatible packages -->
    <PackageReference Include="FluentScheduler" Version="5.3.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.6.16" />
    <PackageReference Include="JetBrains.Annotations" Version="11.1.0" />
    <PackageReference Include="Lambda2Js.Signed" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.11" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
    <PackageReference Include="Nito.AsyncEx.Tasks" Version="5.1.2" />
    <PackageReference Include="Nito.Collections.Deque" Version="1.1.1" />
    <PackageReference Include="Nito.Disposables" Version="2.2.1" />
    <PackageReference Include="snipervld.WebOptimizer.Dotless" Version="3.3.0" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    
    <!-- Updated security-vulnerable packages -->
    <PackageReference Include="jQuery" Version="3.7.1" />
    <PackageReference Include="jQuery.Validation" Version="1.21.0" />
    
    <!-- Replacement packages for .NET 8 -->
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.14" />
    <PackageReference Include="NLog.Targets.Loki" Version="2.4.1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="RedditSharp" Version="2.0.0" />
    
    <PackageReference Include="RavenDB.Client" Version="7.2.1" />
    <PackageReference Include="WilderMinds.MetaWeblog" Version="5.1.3" />

    <!-- Pin transitive dependencies to fix known vulnerabilities -->
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
    <PackageReference Include="System.Formats.Asn1" Version="8.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
  </ItemGroup>

  <!-- Clean generated CSS files on Clean -->
  <Target Name="CleanBundledFiles" AfterTargets="Clean">
    <ItemGroup>
      <FilesToDelete Include="wwwroot\css\styles.css" />
      <FilesToDelete Include="wwwroot\css\styles.min.css" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
    <Message Text="Cleaned generated CSS files" Importance="high" />
  </Target>
  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>
</Project>
